# 复制为 .env 后按需修改；密钥只放服务端环境变量，禁止写入代码仓库。
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root

# JWT 签名密钥：必填，必须 ≥32 字节，过短或缺失时后端拒绝启动。
# 生成示例（PowerShell）：-join ((48..57)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
# 生成示例（bash）：openssl rand -base64 48
JWT_SECRET=

# token 有效期（分钟），默认 720（12 小时）
# JWT_EXPIRATION_MINUTES=720

# ---- 检索与问答（服务端专用，浏览器不得获得以下任何密钥）----
# Qdrant 向量库（只存向量与关联编号，不存正文）
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=campusclaw_chunks
# 嵌入网关（OpenAI 兼容 /embeddings）
EMBEDDING_BASE_URL=https://embedding.example/v1
EMBEDDING_API_KEY=<your-embedding-key>
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# 对话网关（OpenAI 兼容 /chat/completions）
CHAT_BASE_URL=https://chat.example/v1
CHAT_API_KEY=<your-chat-key>
CHAT_MODEL=gpt-4o-mini
